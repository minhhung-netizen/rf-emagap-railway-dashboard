//@version=5
strategy("Modern Chart Stock Strategy Webhook", overlay=false, initial_capital=1000000000, pyramiding=20, process_orders_on_close=true, calc_on_every_tick=false)

// =====================================================
// Distance MA Settings
// =====================================================
grpDistMA = "Distance MA Settings"
lengthMA = input.int(250, "Distance MA Length", minval=1, group=grpDistMA)
maTypeOpt = input.string("SMA", "Distance MA Type", options=["SMA", "EMA", "WMA", "RMA", "HMA", "VWMA"], group=grpDistMA)
maSourceOpt = input.string("Close", "Distance MA Source", options=["Close", "Open", "High", "Low", "HL2", "HLC3", "OHLC4"], group=grpDistMA)
timeframeInput = input.timeframe("", "Custom Timeframe leave empty for current", group=grpDistMA)

// =====================================================
// EMA Cross Settings
// =====================================================
grpCrossEMA = "EMA Cross Settings"
fastEmaLen = input.int(21, "Fast EMA Length", minval=1, group=grpCrossEMA)
slowEmaLen = input.int(89, "Slow EMA Length", minval=1, group=grpCrossEMA)

// =====================================================
// Trade Direction
// =====================================================
grpDir = "Trade Direction"
enableLong = input.bool(true, "Enable Long", group=grpDir)

// =====================================================
// Capital / Quantity
// =====================================================
grpQty = "Position Size"
baseOrderPct = input.float(10.0, "Base Order Size % Equity", minval=0.1, step=0.1, group=grpQty)
roundQty = input.bool(true, "Round Quantity by Lot Size", group=grpQty)
lotSize = input.float(100, "Lot Size", minval=1, step=1, group=grpQty)

// =====================================================
// Compact DCA Settings
// =====================================================
grpDCA = "Compact DCA Settings"
useDCA = input.bool(false, "Enable DCA", group=grpDCA)
maxDcaSteps = input.int(10, "Max DCA Steps", minval=0, maxval=20, group=grpDCA)
dcaTriggerBy = input.string("Close", "DCA Trigger By", options=["Close", "Low"], group=grpDCA)
dcaDistanceList = input.string("1", "DCA Distance Steps %", group=grpDCA)
dcaMultiplierList = input.string("1.2", "DCA Multiplier Steps", group=grpDCA)
lockDcaAfterTP = input.bool(true, "Lock DCA After Any TP / Partial Sell", group=grpDCA)

// =====================================================
// Long TP by Distance
// =====================================================
grpTP = "Long TP by Distance"
useLongTP = input.bool(true, "Enable Long TP", group=grpTP)
tpCalcMode = input.string("From Entry Distance", "TP Calculation Mode", options=["Fixed Distance Level", "From Entry Distance"], group=grpTP)
longTpTriggerBy = input.string("Close", "Long TP Trigger By", options=["Close", "High"], group=grpTP)
showTpTargets = input.bool(true, "Show TP Target Lines", group=grpTP)

longTp1On = input.bool(true, "Enable Long TP1", group=grpTP)
longTp1Level = input.float(30.0, "Long TP1 Distance / Gain From Entry", step=0.1, group=grpTP)
longTp1Pct = input.float(30.0, "Long TP1 Close % From TP Base Qty", minval=0.1, maxval=100, step=0.1, group=grpTP)

longTp2On = input.bool(true, "Enable Long TP2", group=grpTP)
longTp2Level = input.float(35.0, "Long TP2 Distance / Gain From Entry", step=0.1, group=grpTP)
longTp2Pct = input.float(30.0, "Long TP2 Close % From TP Base Qty", minval=0.1, maxval=100, step=0.1, group=grpTP)

longTp3On = input.bool(true, "Enable Long TP3", group=grpTP)
longTp3Level = input.float(40.0, "Long TP3 Distance / Gain From Entry", step=0.1, group=grpTP)
longTp3Pct = input.float(100.0, "Long TP3 Close % From TP Base Qty", minval=0.1, maxval=100, step=0.1, group=grpTP)

// =====================================================
// Supertrend
// =====================================================
grpSup = "Supertrend"
stLen = input.int(30, "Supertrend ATR Length", minval=1, group=grpSup)
stMult = input.float(6.0, "Supertrend Multiplier", minval=0.1, step=0.1, group=grpSup)
stSrcOpt = input.string("HL2", "Supertrend Source on Distance candles", options=["HL2", "Close", "OHLC4"], group=grpSup)
showST = input.bool(true, "Show Supertrend", group=grpSup)

// =====================================================
// EMA Signal Filters
// =====================================================
grpEMA = "EMA Signal Filters"
showSig = input.bool(true, "Show Signals", group=grpEMA)
useSTFilter = input.bool(false, "Filter Entry by Supertrend", group=grpEMA)
useLongBelowTP1Filter = input.bool(false, "Only LONG when Distance < Long TP1", group=grpEMA)

useEmaGapFilter = input.bool(false, "Filter by EMA Gap", group=grpEMA)
minEmaGap = input.float(0.10, "Min EMA Gap", minval=0.0, step=0.05, group=grpEMA)

useEmaSlopeFilter = input.bool(false, "Filter by EMA Slope", group=grpEMA)
emaSlopeLen = input.int(3, "EMA Slope Length", minval=1, group=grpEMA)
minLongFastEmaSlope = input.float(0.05, "Long Min Fast EMA Slope", step=0.01, group=grpEMA)
minLongSlowEmaSlope = input.float(0.00, "Long Min Slow EMA Slope", step=0.01, group=grpEMA)

useCooldown = input.bool(false, "Cooldown After Close", group=grpEMA)
cooldownBars = input.int(5, "Cooldown Bars", minval=1, group=grpEMA)

useEntryZoneFilter = input.bool(true, "Filter Entry by Distance Zone", group=grpEMA)
longEntryMinZone = input.float(-25.0, "Long Entry Min Distance", step=0.1, group=grpEMA)
longEntryMaxZone = input.float(30.0, "Long Entry Max Distance", step=0.1, group=grpEMA)

// =====================================================
// Close Zone Filter
// =====================================================
grpClose = "Close Signal Filter"
useCloseZoneFilter = input.bool(false, "Filter CLOSE by Distance Zone", group=grpClose)
longCloseMinZone = input.float(-100.0, "Long Close Min Distance", step=0.1, group=grpClose)
longCloseMaxZone = input.float(100.0, "Long Close Max Distance", step=0.1, group=grpClose)

// =====================================================
// Smart Exit: EMA Priority + Supertrend State
// =====================================================
grpSmartExit = "Smart Exit EMA Priority + ST State"
useSmartExit = input.bool(true, "Enable Smart Exit by EMA Cross + ST State", group=grpSmartExit)
emaDownPartialPct = input.float(50.0, "Sell % when EMA Cross Down but ST Green", minval=0.1, maxval=100, step=0.1, group=grpSmartExit)
partialEmaDownOnce = input.bool(true, "Only One Partial Sell Before Buy Back", group=grpSmartExit)
useStStateForFullExit = input.bool(true, "EMA Cross Down + ST Red = Close All", group=grpSmartExit)
closeAfterPartialWhenStRed = input.bool(true, "After Partial Sell, Close All When ST Turns Red", group=grpSmartExit)
buyBackPartialOnEmaCrossUp = input.bool(true, "Buy Back Partial When EMA Cross Up and ST Green", group=grpSmartExit)

// =====================================================
// Stop Loss
// =====================================================
grpSL = "Stop Loss"
useStopLoss = input.bool(false, "Enable Stop Loss", group=grpSL)
stopLossPct = input.float(3.0, "Stop Loss % From Avg Price", minval=0.1, step=0.1, group=grpSL)
slTriggerBy = input.string("Low", "SL Trigger By", options=["Close", "Low"], group=grpSL)

// =====================================================
// Trend Regime Filter
// =====================================================
grpRegime = "Trend Regime Filter"
useRegime = input.bool(false, "Enable Trend Regime Filter", group=grpRegime)
slopeLen = input.int(20, "Slope Length", minval=1, group=grpRegime)
slopeTh = input.float(0.00, "Slope Threshold per bar", step=0.0001, group=grpRegime)
volLen = input.int(20, "Volatility Length", minval=1, group=grpRegime)
volTh = input.float(0.08, "Vol Threshold RMS of distance percent", step=0.01, group=grpRegime)

// =====================================================
// Backtest Range
// =====================================================
grpBT = "Backtest Range"
useDateFilter = input.bool(false, "Use Backtest Date Filter", group=grpBT)
startDate = input.time(timestamp("2015-01-01T00:00:00"), "Start Date", group=grpBT)
endDate = input.time(timestamp("2030-12-31T23:59:59"), "End Date", group=grpBT)
inDateRange = not useDateFilter or (time >= startDate and time <= endDate)

// =====================================================
// Dashboard Webhook
// =====================================================
grpDashboard = "Dashboard Webhook"
enableDashboardAlert = input.bool(true, "Send full open/close to Dashboard", group=grpDashboard)
webhookSecret = input.string("change-me", "Webhook Secret", group=grpDashboard)
dashboardStrategy = input.string("Modern Stock EMA", "Dashboard Strategy", group=grpDashboard)
dashboardTickerOverride = input.string("", "Ticker Override - leave empty for chart symbol", group=grpDashboard, tooltip="Use this only if TradingView sends an adjusted symbol. Example: HOSE:PNJ")
sendPartialAsConfirm = input.bool(false, "Send DCA/TP/Partial as confirm notes", group=grpDashboard, tooltip="Default OFF. When ON, DCA and buy-back send confirm_buy: when Dashboard Strategy equals Base Strategy (e.g. both Modern Stock EMA Gap Layer for EMA Daily), the dashboard adds DEFAULT_SIGNAL_WEIGHT_PCT (5% by default) to the open base position and counts it against rebalance caps; a different strategy is recorded at 0%. TP and partial sells send confirm_sell, which keeps the allocation; only a full sell closes the position.")
baseStrategy = input.string("Modern Stock EMA", "Base Strategy for confirm notes", group=grpDashboard)


// =====================================================
// Helper Functions
// =====================================================
f_ma(_src, _len, _type) =>
    _type == "EMA" ? ta.ema(_src, _len) : _type == "WMA" ? ta.wma(_src, _len) : _type == "RMA" ? ta.rma(_src, _len) : _type == "HMA" ? ta.hma(_src, _len) : _type == "VWMA" ? ta.vwma(_src, _len) : ta.sma(_src, _len)

getQty(_pct, _mult) =>
    rawQty = strategy.equity * (_pct / 100.0) * _mult / close
    fixedQty = roundQty ? math.floor(rawQty / lotSize) * lotSize : rawQty
    fixedQty

fixQty(_qty) =>
    fixedQty = roundQty ? math.floor(_qty / lotSize) * lotSize : _qty
    fixedQty

getCsvFloat(_csv, _step, _default) =>
    arr = str.split(_csv, ",")
    arrSize = array.size(arr)
    idxRaw = _step - 1
    idx = idxRaw < 0 ? 0 : idxRaw
    idxFinal = arrSize <= 0 ? 0 : idx >= arrSize ? arrSize - 1 : idx
    txt = arrSize <= 0 ? "" : array.get(arr, idxFinal)
    val = str.tonumber(txt)
    na(val) ? _default : val

// =====================================================
// TF Sync
// =====================================================
tfUsed = timeframeInput == "" ? timeframe.period : timeframeInput

oTF = request.security(syminfo.tickerid, tfUsed, open, barmerge.gaps_off, barmerge.lookahead_off)
hTF = request.security(syminfo.tickerid, tfUsed, high, barmerge.gaps_off, barmerge.lookahead_off)
lTF = request.security(syminfo.tickerid, tfUsed, low, barmerge.gaps_off, barmerge.lookahead_off)
cTF = request.security(syminfo.tickerid, tfUsed, close, barmerge.gaps_off, barmerge.lookahead_off)

maTF = request.security(syminfo.tickerid, tfUsed, f_ma(maSourceOpt == "Close" ? close : maSourceOpt == "Open" ? open : maSourceOpt == "High" ? high : maSourceOpt == "Low" ? low : maSourceOpt == "HL2" ? hl2 : maSourceOpt == "HLC3" ? hlc3 : ohlc4, lengthMA, maTypeOpt), barmerge.gaps_off, barmerge.lookahead_off)

// =====================================================
// Distance Candles
// =====================================================
distanceC = (cTF - maTF) / maTF * 100
distanceH = (hTF - maTF) / maTF * 100
distanceL = (lTF - maTF) / maTF * 100
distanceO = (oTF - maTF) / maTF * 100

ma250C = ta.sma(distanceC, 250)
emaFastC = ta.ema(distanceC, fastEmaLen)
emaSlowC = ta.ema(distanceC, slowEmaLen)

// =====================================================
// Plot Base
// =====================================================
hline(0, "Zero Line", color=#d229e1, linestyle=hline.style_dotted)
plotcandle(open=distanceO, high=distanceH, low=distanceL, close=distanceC, color=distanceC >= distanceO ? #f307c0 : #eeff52, wickcolor=distanceC >= distanceO ? #f307c0 : #eeff52, bordercolor=distanceC >= distanceO ? #f307c0 : #eeff52, title="Distance Candle")
plot(ma250C, "MA250 Distance", color=#e600c7)
plot(emaFastC, "Fast EMA Distance", color=color.rgb(0, 230, 69), linewidth=2)
plot(emaSlowC, "Slow EMA Distance", color=#b0e600, linewidth=2)

// =====================================================
// Regime Logic
// =====================================================
slope = (emaSlowC - emaSlowC[slopeLen]) / slopeLen
rms = math.sqrt(ta.sma(distanceC * distanceC, volLen))
regimeOK = not useRegime or (math.abs(slope) > slopeTh and rms > volTh)

// =====================================================
// Supertrend on Distance OHLC
// =====================================================
src = stSrcOpt == "Close" ? distanceC : stSrcOpt == "OHLC4" ? (distanceO + distanceH + distanceL + distanceC) / 4.0 : (distanceH + distanceL) / 2.0
prevSrc = nz(src[1], src)

tr1 = distanceH - distanceL
tr2 = math.abs(distanceH - prevSrc)
tr3 = math.abs(distanceL - prevSrc)
tr = math.max(tr1, math.max(tr2, tr3))

atr = ta.rma(tr, stLen)
hl2Dist = (distanceH + distanceL) / 2.0

basicUpper = hl2Dist + stMult * atr
basicLower = hl2Dist - stMult * atr

var float finalUpper = na
var float finalLower = na

finalUpper := na(finalUpper[1]) ? basicUpper : basicUpper < finalUpper[1] or prevSrc > finalUpper[1] ? basicUpper : finalUpper[1]
finalLower := na(finalLower[1]) ? basicLower : basicLower > finalLower[1] or prevSrc < finalLower[1] ? basicLower : finalLower[1]

var bool stUp = true
stUp := na(stUp[1]) ? true : stUp[1] ? src >= finalLower[1] : src > finalUpper[1]

stLine = stUp ? finalLower : finalUpper
plot(showST ? stLine : na, "Supertrend Distance", color=stUp ? color.lime : color.red, linewidth=2)

// =====================================================
// EMA Signals
// =====================================================
emaCrossUp = ta.crossover(emaFastC, emaSlowC)
emaCrossDown = ta.crossunder(emaFastC, emaSlowC)

emaBullGap = emaFastC - emaSlowC
emaGapLongOK = not useEmaGapFilter or emaBullGap >= minEmaGap

emaFastSlope = emaFastC - emaFastC[emaSlopeLen]
emaSlowSlope = emaSlowC - emaSlowC[emaSlopeLen]
emaSlopeLongOK = not useEmaSlopeFilter or (emaFastSlope >= minLongFastEmaSlope and emaSlowSlope >= minLongSlowEmaSlope)

longSTOK = not useSTFilter or stUp
longBelowTP1OK = not useLongBelowTP1Filter or distanceC < longTp1Level
longEntryZoneOK = not useEntryZoneFilter or (distanceC >= longEntryMinZone and distanceC < longEntryMaxZone)
longCloseZoneOK = not useCloseZoneFilter or (distanceC >= longCloseMinZone and distanceC < longCloseMaxZone)

// =====================================================
// Trade State
// =====================================================
var bool inTrade = false
var int dcaCount = 0
var float lastEntryPrice = na
var float entryDistance = na
var int lastCloseBar = na
var bool tp1Done = false
var bool tp2Done = false
var bool tp3Done = false
var bool anyTpDone = false
var bool emaDownPartialDone = false
var bool emaDownPartialUsed = false
var float emaDownPartialSoldQty = na
var float tpBaseQty = na

cooldownOK = not useCooldown or na(lastCloseBar) or bar_index - lastCloseBar > cooldownBars

if strategy.position_size <= 0 and inTrade
    inTrade := false
    dcaCount := 0
    lastEntryPrice := na
    entryDistance := na
    lastCloseBar := bar_index
    tp1Done := false
    tp2Done := false
    tp3Done := false
    anyTpDone := false
    emaDownPartialDone := false
    emaDownPartialUsed := false
    emaDownPartialSoldQty := na
    tpBaseQty := na

// =====================================================
// Main Signals - Long Only
// =====================================================
longEntryFilterOK = longSTOK and longBelowTP1OK and emaGapLongOK and emaSlopeLongOK and longEntryZoneOK and cooldownOK and regimeOK and inDateRange
longSignal = barstate.isconfirmed and enableLong and emaCrossUp and not inTrade and longEntryFilterOK

emaCrossDownExitSignal = barstate.isconfirmed and emaCrossDown and longCloseZoneOK and inTrade
emaDownPartialOK = not emaDownPartialDone and (not partialEmaDownOnce or not emaDownPartialUsed)

emaDownPartialSignal = useSmartExit and emaCrossDownExitSignal and stUp and emaDownPartialOK
emaDownFullCloseSignal = useSmartExit ? emaCrossDownExitSignal and (not useStStateForFullExit or not stUp) : emaCrossDownExitSignal

stRedAfterPartialSignal = barstate.isconfirmed and useSmartExit and closeAfterPartialWhenStRed and inTrade and emaDownPartialDone and stUp[1] and not stUp

closeLongSignal = emaDownFullCloseSignal or stRedAfterPartialSignal

// =====================================================
// Stop Loss
// =====================================================
avgPrice = strategy.position_avg_price
longSlPrice = avgPrice * (1.0 - stopLossPct / 100.0)
slLongTriggerPrice = slTriggerBy == "Low" ? low : close
longSlSignal = barstate.isconfirmed and useStopLoss and inTrade and strategy.position_size > 0 and slLongTriggerPrice <= longSlPrice

buyBackPartialSignal = barstate.isconfirmed and buyBackPartialOnEmaCrossUp and inTrade and emaDownPartialDone and not na(emaDownPartialSoldQty) and emaCrossUp and stUp and not closeLongSignal and not longSlSignal

// =====================================================
// Take Profit From Entry Distance
// =====================================================
longTpValue = longTpTriggerBy == "High" ? distanceH : distanceC

longTp1Target = tpCalcMode == "From Entry Distance" and not na(entryDistance) ? entryDistance + longTp1Level : longTp1Level
longTp2Target = tpCalcMode == "From Entry Distance" and not na(entryDistance) ? entryDistance + longTp2Level : longTp2Level
longTp3Target = tpCalcMode == "From Entry Distance" and not na(entryDistance) ? entryDistance + longTp3Level : longTp3Level

longTp1Signal = barstate.isconfirmed and useLongTP and inTrade and not closeLongSignal and not emaDownPartialSignal and not buyBackPartialSignal and not longSlSignal and longTp1On and not tp1Done and longTpValue >= longTp1Target
longTp2Signal = barstate.isconfirmed and useLongTP and inTrade and not closeLongSignal and not emaDownPartialSignal and not buyBackPartialSignal and not longSlSignal and not longTp1Signal and longTp2On and not tp2Done and longTpValue >= longTp2Target
longTp3Signal = barstate.isconfirmed and useLongTP and inTrade and not closeLongSignal and not emaDownPartialSignal and not buyBackPartialSignal and not longSlSignal and not longTp1Signal and not longTp2Signal and longTp3On and not tp3Done and longTpValue >= longTp3Target

hasTpSignal = longTp1Signal or longTp2Signal or longTp3Signal

plot(inTrade and useLongTP and showTpTargets ? longTp1Target : na, "TP1 Target Distance", color=color.yellow, linewidth=1)
plot(inTrade and useLongTP and showTpTargets ? longTp2Target : na, "TP2 Target Distance", color=color.orange, linewidth=1)
plot(inTrade and useLongTP and showTpTargets ? longTp3Target : na, "TP3 Target Distance", color=color.red, linewidth=1)

// =====================================================
// DCA Logic - Long Only
// =====================================================
dcaNextStep = dcaCount + 1
dcaStepDistancePct = getCsvFloat(dcaDistanceList, dcaNextStep, 1.0)
dcaStepMultiplier = getCsvFloat(dcaMultiplierList, dcaNextStep, 1.0)

dcaLongTriggerPrice = dcaTriggerBy == "Low" ? low : close
longDcaPriceOK = not na(lastEntryPrice) and dcaLongTriggerPrice <= lastEntryPrice * (1.0 - dcaStepDistancePct / 100.0)

dcaLockOK = not lockDcaAfterTP or not anyTpDone
longDcaSignal = barstate.isconfirmed and useDCA and inTrade and not closeLongSignal and not emaDownPartialSignal and not buyBackPartialSignal and not longSlSignal and not hasTpSignal and dcaLockOK and dcaNextStep <= maxDcaSteps and longDcaPriceOK and inDateRange


// =====================================================
// End Date Close Signal
// =====================================================
endDateCloseSignal = barstate.isconfirmed and useDateFilter and time > endDate and inTrade

// =====================================================
// Strategy Orders
// =====================================================
baseQty = getQty(baseOrderPct, 1.0)

if longSignal and baseQty > 0
    strategy.entry("LONG", strategy.long, qty=baseQty)
    inTrade := true
    dcaCount := 0
    lastEntryPrice := close
    entryDistance := distanceC
    tpBaseQty := baseQty
    tp1Done := false
    tp2Done := false
    tp3Done := false
    anyTpDone := false
    emaDownPartialDone := false
    emaDownPartialUsed := false
    emaDownPartialSoldQty := na

dcaQty = getQty(baseOrderPct, dcaStepMultiplier)

if longDcaSignal and dcaQty > 0
    strategy.entry("LONG DCA " + str.tostring(dcaNextStep), strategy.long, qty=dcaQty)
    dcaCount += 1
    lastEntryPrice := close
    tpBaseQty := na(tpBaseQty) ? dcaQty : tpBaseQty + dcaQty

posQty = math.abs(strategy.position_size)

emaDownPartialQty = fixQty(posQty * emaDownPartialPct / 100.0)

if emaDownPartialSignal and posQty > 0 and emaDownPartialQty > 0
    soldQty = math.min(emaDownPartialQty, posQty)
    strategy.order("EMA DOWN PARTIAL", strategy.short, qty=soldQty, comment="EMA Cross Down ST Green Partial Sell")
    emaDownPartialDone := true
    emaDownPartialUsed := true
    emaDownPartialSoldQty := soldQty
    tpBaseQty := na(tpBaseQty) ? math.max(posQty - soldQty, 0) : math.max(tpBaseQty - soldQty, 0)
    anyTpDone := true

if buyBackPartialSignal and emaDownPartialSoldQty > 0
    buyBackQty = emaDownPartialSoldQty
    strategy.entry("BUY BACK PARTIAL", strategy.long, qty=buyBackQty)
    tpBaseQty := na(tpBaseQty) ? posQty + buyBackQty : tpBaseQty + buyBackQty
    emaDownPartialDone := false
    emaDownPartialUsed := false
    emaDownPartialSoldQty := na

tpQtyBase = na(tpBaseQty) or tpBaseQty <= 0 ? posQty : tpBaseQty

longTp1Qty = fixQty(tpQtyBase * longTp1Pct / 100.0)
longTp2Qty = fixQty(tpQtyBase * longTp2Pct / 100.0)
longTp3Qty = fixQty(tpQtyBase * longTp3Pct / 100.0)

if longTp1Signal and posQty > 0 and longTp1Qty > 0
    strategy.order("LONG TP1", strategy.short, qty=math.min(longTp1Qty, posQty), comment="Long TP1")
    tp1Done := true
    anyTpDone := true

if longTp2Signal and posQty > 0 and longTp2Qty > 0
    strategy.order("LONG TP2", strategy.short, qty=math.min(longTp2Qty, posQty), comment="Long TP2")
    tp2Done := true
    anyTpDone := true

if longTp3Signal and posQty > 0 and longTp3Qty > 0
    strategy.order("LONG TP3", strategy.short, qty=math.min(longTp3Qty, posQty), comment="Long TP3")
    tp3Done := true
    anyTpDone := true

if longSlSignal
    strategy.close_all(comment="Stop Loss Whole Position")
    inTrade := false
    dcaCount := 0
    lastEntryPrice := na
    entryDistance := na
    lastCloseBar := bar_index
    tp1Done := false
    tp2Done := false
    tp3Done := false
    anyTpDone := false
    emaDownPartialDone := false
    emaDownPartialUsed := false
    emaDownPartialSoldQty := na
    tpBaseQty := na

if closeLongSignal and not longSlSignal
    if stRedAfterPartialSignal
        strategy.close_all(comment="Close All ST Red After EMA Partial")
    else
        strategy.close_all(comment="Close Long EMA Cross Down With ST Red")
    inTrade := false
    dcaCount := 0
    lastEntryPrice := na
    entryDistance := na
    lastCloseBar := bar_index
    tp1Done := false
    tp2Done := false
    tp3Done := false
    anyTpDone := false
    emaDownPartialDone := false
    emaDownPartialUsed := false
    emaDownPartialSoldQty := na
    tpBaseQty := na

if endDateCloseSignal
    strategy.close_all(comment="End Date Close")
    inTrade := false
    dcaCount := 0
    lastEntryPrice := na
    entryDistance := na
    lastCloseBar := bar_index
    tp1Done := false
    tp2Done := false
    tp3Done := false
    anyTpDone := false
    emaDownPartialDone := false
    emaDownPartialUsed := false
    emaDownPartialSoldQty := na
    tpBaseQty := na

// =====================================================
// Plot Signals
// =====================================================
plotshape(showSig and longSignal, title="LONG", style=shape.triangleup, location=location.bottom, text="LONG", size=size.small, color=color.lime, textcolor=color.black)
plotshape(showSig and longDcaSignal, title="Long DCA", style=shape.circle, location=location.bottom, text="DCA", size=size.tiny, color=color.aqua, textcolor=color.black)

plotshape(showSig and longTp1Signal, title="Long TP1", style=shape.diamond, location=location.top, text="TP1", size=size.tiny, color=color.yellow, textcolor=color.black)
plotshape(showSig and longTp2Signal, title="Long TP2", style=shape.diamond, location=location.top, text="TP2", size=size.tiny, color=color.orange, textcolor=color.black)
plotshape(showSig and longTp3Signal, title="Long TP3", style=shape.diamond, location=location.top, text="TP3", size=size.tiny, color=color.red, textcolor=color.white)

plotshape(showSig and emaDownPartialSignal, title="EMA Down Partial Sell", style=shape.diamond, location=location.top, text="SELL\n%", size=size.small, color=color.orange, textcolor=color.black)
plotshape(showSig and buyBackPartialSignal, title="Buy Back Partial", style=shape.triangleup, location=location.bottom, text="BUY\nBACK", size=size.small, color=color.lime, textcolor=color.black)
plotshape(showSig and stRedAfterPartialSignal, title="ST Red After EMA Partial", style=shape.xcross, location=location.top, text="ST\nEXIT", size=size.small, color=color.red, textcolor=color.white)

plotshape(showSig and closeLongSignal, title="Close Long", style=shape.xcross, location=location.top, text="CL", size=size.small, color=color.red, textcolor=color.white)
plotshape(showSig and longSlSignal, title="Stop Loss", style=shape.xcross, location=location.top, text="SL", size=size.small, color=color.red, textcolor=color.white)

bgcolor(useRegime and not regimeOK ? color.new(color.gray, 92) : na)

// =====================================================
// Dashboard Payload Helpers
// =====================================================
f_json_escape(string _text) =>
    string escaped = str.replace_all(_text, "\\", "\\\\")
    escaped := str.replace_all(escaped, "\"", "\\\"")
    escaped := str.replace_all(escaped, "\n", " ")
    escaped

f_dashboard_ticker() =>
    dashboardTickerOverride != "" ? dashboardTickerOverride : (syminfo.prefix != "" ? syminfo.prefix + ":" + syminfo.ticker : syminfo.ticker)

f_dashboard_payload(string _action, float _price, string _note, string _signalType) =>
    "{" +
      "\"ticker\":\"" + f_json_escape(f_dashboard_ticker()) + "\"," +
      "\"action\":\"" + _action + "\"," +
      "\"price\":\"" + str.tostring(_price, format.mintick) + "\"," +
      "\"timeframe\":\"" + tfUsed + "\"," +
      "\"strategy\":\"" + f_json_escape(dashboardStrategy) + "\"," +
      "\"base_strategy\":\"" + f_json_escape(baseStrategy) + "\"," +
      "\"signal_type\":\"" + _signalType + "\"," +
      "\"time\":\"" + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ssXXX", syminfo.timezone) + "\"," +
      "\"note\":\"" + f_json_escape(_note) + "\"," +
      "\"secret\":\"" + f_json_escape(webhookSecret) + "\"" +
      "}"

f_send_dashboard(string _action, float _price, string _note, string _signalType) =>
    alert(f_dashboard_payload(_action, _price, _note, _signalType), alert.freq_once_per_bar_close)

// =====================================================
// Alerts
// =====================================================
alertcondition(longSignal, title="LONG", message="LONG: Fast EMA cat len Slow EMA")
alertcondition(longDcaSignal, title="LONG DCA", message="LONG DCA: Gia giam du khoang cach DCA")
alertcondition(longTp1Signal, title="LONG TP1", message="LONG TP1: Distance cham moc TP1 target")
alertcondition(longTp2Signal, title="LONG TP2", message="LONG TP2: Distance cham moc TP2 target")
alertcondition(longTp3Signal, title="LONG TP3", message="LONG TP3: Distance cham moc TP3 target")
alertcondition(emaDownPartialSignal, title="EMA DOWN PARTIAL SELL", message="EMA Fast cat xuong Slow nhung Supertrend con xanh: ban mot phan vi the")
alertcondition(buyBackPartialSignal, title="BUY BACK PARTIAL", message="EMA Fast cat len Slow lai va Supertrend van xanh: mua lai dung phan da ban")
alertcondition(stRedAfterPartialSignal, title="ST RED AFTER EMA PARTIAL", message="Supertrend chuyen do sau khi da ban mot phan do EMA cross down: ban het phan con lai")
alertcondition(closeLongSignal, title="CLOSE LONG", message="CLOSE LONG: Thoat lenh theo EMA/ST Smart Exit")
alertcondition(longSlSignal, title="STOP LOSS", message="STOP LOSS: Dong toan bo vi the")
alertcondition(endDateCloseSignal, title="END DATE CLOSE", message="END DATE CLOSE: Dong vi the do het khoang backtest")

if barstate.isconfirmed and enableDashboardAlert
    if longSignal
        f_send_dashboard("buy", close, "LONG entry; distanceC=" + str.tostring(distanceC, format.mintick) + "%" + "; emaFast=" + str.tostring(emaFastC, format.mintick) + "; emaSlow=" + str.tostring(emaSlowC, format.mintick) + "; ST=" + (stUp ? "UP" : "DOWN"), "entry")
    else if longSlSignal
        f_send_dashboard("sell", close, "STOP LOSS full close; distanceC=" + str.tostring(distanceC, format.mintick) + "%" + "; avgPrice=" + str.tostring(avgPrice, format.mintick), "exit")
    else if closeLongSignal
        string exitNote = stRedAfterPartialSignal ? "ST red after EMA partial full close" : "EMA/ST smart exit full close"
        f_send_dashboard("sell", close, exitNote + "; distanceC=" + str.tostring(distanceC, format.mintick) + "%" + "; ST=" + (stUp ? "UP" : "DOWN"), "exit")
    else if endDateCloseSignal
        f_send_dashboard("sell", close, "End date full close; distanceC=" + str.tostring(distanceC, format.mintick) + "%", "exit")

    if sendPartialAsConfirm
        if longDcaSignal
            f_send_dashboard("confirm_buy", close, "DCA top-up; step=" + str.tostring(dcaNextStep) + "; distanceC=" + str.tostring(distanceC, format.mintick) + "%", "confirm")
        if buyBackPartialSignal
            f_send_dashboard("confirm_buy", close, "Buy back partial top-up; distanceC=" + str.tostring(distanceC, format.mintick) + "%", "confirm")
        if emaDownPartialSignal
            f_send_dashboard("confirm_sell", close, "EMA down partial sell; allocation kept until full close", "confirm")
        if longTp1Signal
            f_send_dashboard("confirm_sell", close, "TP1 partial sell; allocation kept until full close", "confirm")
        if longTp2Signal
            f_send_dashboard("confirm_sell", close, "TP2 partial sell; allocation kept until full close", "confirm")
        if longTp3Signal
            f_send_dashboard("confirm_sell", close, "TP3 partial sell; allocation kept until full close", "confirm")
