# Optional. When set, TradingView webhook payloads must include this value
# as either ?secret=... or {"secret": "..."}.
WEBHOOK_SECRET=change-me

# Separate token for a trusted local backtest runner to publish report snapshots.
# Send it only in the X-Backtest-Ingest-Token request header; never in TradingView.
BACKTEST_INGEST_TOKEN=change-me-too

# Dashboard login. Change ADMIN_PASSWORD before deploying publicly.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_DAYS=30

# SQLite database path. Relative paths are resolved from the project root.
DATABASE_PATH=data/signals.db

# Refresh prices for open positions while the Vietnamese market is open.
PRICE_REFRESH_MINUTES=120
MARKET_SESSIONS=09:00-11:30,13:00-15:00

# DNSE is the primary market-data provider when both credentials are set.
# Add these as Railway Variables. Never commit real credentials.
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_API_VERSION=2026-05-07

# FireAnt supplies daily OHLCV history and dated dividend-event notes.
# The OAuth access token needs the symbols-read scope.
FIREANT_ACCESS_TOKEN=
FIREANT_BASE_URL=https://api.fireant.vn
FIREANT_CACHE_TTL_MINUTES=240
FIREANT_MIN_REQUEST_INTERVAL_SECONDS=1

# Vnstock free-tier request control. Current public docs mention 60 requests/minute
# and 3000 requests/hour. It remains the fallback when DNSE is unavailable.
VNSTOCK_CACHE_TTL_MINUTES=240
VNSTOCK_MIN_REQUEST_INTERVAL_SECONDS=4
VNSTOCK_LOOKBACK_DAYS=90
VNSTOCK_INCLUDE_METRICS=false

# When TradingView repeats the same alert, ignore it instead of inserting
# another signal. If payload "time" is present, the app uses exact candle time.
# If not, it uses this rolling window.
DUPLICATE_WINDOW_MINUTES=5

# Default capital allocation used to convert signal returns into portfolio P/L.
DEFAULT_SIGNAL_WEIGHT_PCT=5

# VN30 futures contract value in VND per index point.
DERIVATIVE_CONTRACT_MULTIPLIER=100000
DERIVATIVE_INITIAL_CAPITAL=100000000
